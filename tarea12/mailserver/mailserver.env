# tarea12/mailserver/mailserver.env
# Configuracion docker-mailserver — Tarea 12
# Documentacion: https://docker-mailserver.github.io/

# ─── Componentes del stack ───────────────────────────────────────────────────
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
ENABLE_FAIL2BAN=1
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1
ENABLE_AMAVIS=0

# ─── TLS forzado ─────────────────────────────────────────────────────────────
TLS_LEVEL=modern
SMTPS_PORT=465
SUBMISSION_PORT=587

# ─── Identidad del servidor ──────────────────────────────────────────────────
POSTMASTER_ADDRESS=postmaster@reprobados.com
HOSTNAME=mail
DOMAINNAME=reprobados.com

# ─── Seguridad y autenticacion ───────────────────────────────────────────────
SPOOF_PROTECTION=1
ENABLE_DNSBL=1
FAIL2BAN_BLOCKTYPE=drop
FAIL2BAN_MAXRETRY=5
FAIL2BAN_FINDTIME=600
FAIL2BAN_BANTIME=3600

# ─── Logging y auditoria ─────────────────────────────────────────────────────
LOG_LEVEL=info
LOGWATCH_INTERVAL=daily

# ─── Dovecot / IMAP ──────────────────────────────────────────────────────────
DOVECOT_MAILBOX_FORMAT=maildir
ENABLE_IMAP=1
ENABLE_POP3=0

# ─── Postfix / SMTP ──────────────────────────────────────────────────────────
ENABLE_SMTP=1
POSTFIX_INET_PROTOCOLS=ipv4
PERMIT_DOCKER=network

# ─── One directory per user ──────────────────────────────────────────────────
ONE_DIR=1
