# tarea12/.env.example
# Plantilla — copiar a .env

MAIL_DOMAIN=reprobados.com
MAIL_HOSTNAME=mail.reprobados.com

SMTP_PORT=25
SUBMISSION_PORT=587
SMTPS_PORT=465
IMAP_PORT=143
IMAPS_PORT=993

WEBMAIL_HTTP_PORT=80
WEBMAIL_HTTPS_PORT=443

DIRECTOR_EMAIL=director@reprobados.com
DIRECTOR_PASSWORD=<cambiar>
ADMIN_EMAIL=admin@reprobados.com
ADMIN_PASSWORD=<cambiar>

ROUNDCUBE_VERSION=1.6-apache
MARIADB_VERSION=10.11
ROUNDCUBE_DB_NAME=roundcube
ROUNDCUBE_DB_USER=roundcube
ROUNDCUBE_DB_PASSWORD=<cambiar>
ROUNDCUBE_DB_ROOT_PASSWORD=<cambiar>

BACKUP_INTERVAL=86400
FAIL2BAN_MAX_RETRY=5
FAIL2BAN_BAN_TIME=3600
