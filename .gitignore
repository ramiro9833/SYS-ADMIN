# .gitignore - SYS-ADMIN
# Archivos y carpetas excluidos del control de versiones

# Informes y documentación (entregables privados)
docs/

# Respaldos automáticos generados por los scripts
**/*.bak.*
**/*.bak_*

# Archivos temporales del sistema
*.swp
*.tmp
*~
.DS_Store
Thumbs.db

# Archivos de configuración con datos sensibles
**/*.leases
**/*.log

# Instaladores y binarios grandes (no se suben al repositorio)
*.tar.gz
*.zip
*.deb
*.msi
*.exe
*.rpm
*.rar
*.7z

# Carpetas extraídas temporalmente o de dependencias
apache-tomcat-*/

# Archivos de depuración y notas personales
xd.txt
temp*
debug*

# Respaldos PostgreSQL generados por Tarea 10
tarea10/backups/*.sql.gz

# Variables de entorno con credenciales (Tarea 11)
tarea11/.env

# Variables de entorno con credenciales (Tarea 12)
tarea12/.env
tarea12/certs/*.pem
tarea12/backups/mail_data_*.tar.gz
